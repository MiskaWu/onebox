{# Contains secrets: written with no_log, mode 0600, owner caddy. #}
# Managed by onebox (roles/caddy_edge). Environment for the edge Caddy (DNS provider).
{% for name, value in edge_dns_env.items() %}
{{ name }}={{ value }}
{% endfor %}
{% for name, var in _edge_secret_env.items() %}
{% set value = lookup('ansible.builtin.vars', var, default='') %}
{% if value | length > 0 %}
{{ name }}={{ value }}
{% endif %}
{% endfor %}
