{# Go-template delimiters for External Secrets' own templating, kept apart from Jinja's. #}
{% set GO = '{{' %}{% set OG = '}}' %}
# Managed by onebox (roles/external_secrets) — k3s applies this file from its manifests directory.
#
# Needs the External Secrets CRDs and admission webhook, so k3s keeps retrying this file
# (every 15 s) until the chart is installed; the converge waits for it. Always rendered, even
# when no pull secrets are configured, so that removing the last one really removes it
# (k3s prunes objects that leave a file; deleting a file deletes nothing).
---
# How every namespace finds OpenBao. Workloads reference it:
#   secretStoreRef: {kind: ClusterSecretStore, name: {{ external_secrets_store_name }}}
# and declare which keys they need in their own ExternalSecret (the platform owns the values).
apiVersion: external-secrets.io/v1
kind: ClusterSecretStore
metadata:
  name: {{ external_secrets_store_name }}
spec:
  provider:
    # OpenBao speaks the Vault API; External Secrets has no separate OpenBao provider.
    vault:
      server: "{{ external_secrets_openbao_url }}"
      path: {{ openbao_kv_mount }}
      version: {{ external_secrets_kv_version }}
{% if _external_secrets_ca_b64 | length > 0 %}
      # The edge's CA ({{ external_secrets_ca_file }}).
      caBundle: {{ _external_secrets_ca_b64 }}
{% endif %}
      auth:
        kubernetes:
          mountPath: {{ openbao_k8s_auth_mount }}
          role: {{ openbao_eso_role }}
          serviceAccountRef:
            name: {{ external_secrets_service_account }}
            namespace: {{ external_secrets_namespace }}
{% if external_secrets_registry_pull_enabled | bool %}
{% for tenant in external_secrets_registry_pull_tenants %}
{% set registries = tenant.registries | default([{'server': external_secrets_registry_pull_default_registry,
                                                  'kv_path': external_secrets_registry_pull_kv_prefix ~ '/' ~ tenant.name}]) %}
---
# Pull secret for tenant {{ tenant.name }}: a Secret {{ external_secrets_registry_pull_secret_name }} in every namespace labelled
# {{ external_secrets_registry_pull_label }}: {{ tenant.name }} — new namespaces included, without a platform run.
# One rule per tenant: a tenant's namespaces never receive another tenant's credentials.
apiVersion: external-secrets.io/v1
kind: ClusterExternalSecret
metadata:
  name: {{ external_secrets_registry_pull_secret_name }}-{{ tenant.name }}
spec:
  externalSecretName: {{ external_secrets_registry_pull_secret_name }}
  # How often the namespace list is re-evaluated (new namespaces are also picked up by watch).
  refreshTime: {{ external_secrets_registry_pull_refresh }}
  namespaceSelectors:
    - matchLabels:
        {{ external_secrets_registry_pull_label }}: "{{ tenant.name }}"
  externalSecretSpec:
    refreshInterval: {{ external_secrets_registry_pull_refresh }}
    secretStoreRef:
      kind: ClusterSecretStore
      name: {{ external_secrets_store_name }}
    target:
      name: {{ external_secrets_registry_pull_secret_name }}
      # Owner: the Secret belongs to its ExternalSecret. It does not adopt an existing Secret of
      # the same name — delete a hand-made one first, or the ExternalSecret stays in
      # SecretSyncedError without saying why.
      creationPolicy: Owner
      template:
        engineVersion: v2
        type: kubernetes.io/dockerconfigjson
        data:
          # Evaluated by External Secrets: one auths entry per registry, values JSON-escaped.
          .dockerconfigjson: >-
            {"auths":{
{%- for r in registries %}
            {{ r.server | to_json }}:{"username":{{ GO }} .u{{ loop.index0 }} | toJson {{ OG }},"password":{{ GO }} .p{{ loop.index0 }} | toJson {{ OG }},"auth":{{ GO }} printf "%s:%s" .u{{ loop.index0 }} .p{{ loop.index0 }} | b64enc | toJson {{ OG }}}{{ ',' if not loop.last }}
{%- endfor %}
            }}
    # Fail-closed: if any credential below is missing in OpenBao, no Secret is produced.
    data:
{% for r in registries %}
      # {{ r.server }} ← {{ openbao_kv_mount }}/{{ r.kv_path }} (fields username, password)
      - secretKey: u{{ loop.index0 }}
        remoteRef:
          key: {{ r.kv_path }}
          property: username
      - secretKey: p{{ loop.index0 }}
        remoteRef:
          key: {{ r.kv_path }}
          property: password
{% endfor %}
{% endfor %}
{% endif %}
