# Managed by onebox (roles/external_secrets) — k3s applies this file from its manifests directory.
#
# External Secrets Operator (ADR 0017). This file holds only kinds that exist before the chart
# is installed; the store and the pull-secret rules are in onebox-external-secrets-store.yaml,
# because k3s refuses a whole file when one of its kinds is unknown.
# No secrets in here: External Secrets proves its identity with a short-lived service-account
# token (Kubernetes auth), there is no static credential to store.
---
# Declared here (not only by the HelmChart's createNamespace) because the objects below need it
# before the chart runs.
apiVersion: v1
kind: Namespace
metadata:
  name: {{ external_secrets_namespace }}
---
# The identity OpenBao's kubernetes auth role trusts (bound_service_account_names/-namespaces).
# It runs nothing and has no permissions of its own: External Secrets mints short-lived tokens
# for it (TokenRequest) and presents them at login. Kept apart from the controller's account,
# whose token can write Secrets cluster-wide.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ external_secrets_service_account }}
  namespace: {{ external_secrets_namespace }}
automountServiceAccountToken: false
---
# OpenBao validates the presented token with a TokenReview made *with that same token* (no
# long-lived reviewer token is stored in OpenBao). Calling TokenReview needs
# system:auth-delegator, whose whole permission set is TokenReview + SubjectAccessReview — it
# cannot read or change anything. Removing it breaks every login.
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: {{ external_secrets_service_account }}-auth-delegator
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: system:auth-delegator
subjects:
  - kind: ServiceAccount
    name: {{ external_secrets_service_account }}
    namespace: {{ external_secrets_namespace }}
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: external-secrets
  namespace: kube-system
spec:
  # external-secrets chart {{ external_secrets_chart_version }} (External Secrets {{ external_secrets_app_version }}), downloaded with
  # the sha256 from the chart repository index and served by k3s.
  chart: https://%{KUBERNETES_API}%/static/charts/{{ _external_secrets_chart_file }}
  targetNamespace: {{ external_secrets_namespace }}
  createNamespace: true
  # Never uninstall-and-reinstall on a failed upgrade (the default): uninstalling this chart
  # deletes its CRDs, every ExternalSecret with them, and every Secret they own.
  failurePolicy: abort
  valuesContent: |-
    installCRDs: true
    crds:
      # Keep the CRDs when the release is ever uninstalled: deleting them would cascade to every
      # ExternalSecret and, through owner references, every Secret produced from OpenBao.
      annotations:
        helm.sh/resource-policy: keep
    # One node: several replicas would only run leader election.
    replicaCount: 1
    leaderElect: false
    serviceAccount:
      name: {{ external_secrets_controller_service_account }}
    resources:
      {{ external_secrets_resources | to_nice_yaml(indent=2) | indent(6) }}
    webhook:
      replicaCount: 1
      resources:
        {{ external_secrets_webhook_resources | to_nice_yaml(indent=2) | indent(8) }}
    certController:
      replicaCount: 1
      resources:
        {{ external_secrets_cert_controller_resources | to_nice_yaml(indent=2) | indent(8) }}
