{# Contains the NATS password: rendered with no_log, mode 0400, root-owned (the image runs as root). #}
# Managed by onebox (roles/datastores). Mounted read-only at /etc/nats/onebox.conf; it replaces
# the image's default configuration, which enables clustering with a well-known route password.
server_name: onebox
listen: "0.0.0.0:4222"
# Monitoring endpoint for the health check; bound to the container's own loopback.
http: "127.0.0.1:8222"

authorization {
  user: {{ datastores_nats_user | to_json }}
  password: {{ datastores_nats_password | to_json }}
}
{% if datastores_nats_jetstream | bool %}

# Limits only exist here (no command-line flags): without them JetStream claims most of the
# host's memory and disk.
jetstream {
  store_dir: "/data"
  max_memory_store: {{ datastores_nats_jetstream_max_memory }}
  max_file_store: {{ datastores_nats_jetstream_max_file }}
}
{% endif %}
